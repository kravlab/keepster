# The committed `/v1` document is compared byte for byte with the generated one (ticket 40), so a
# checkout must never rewrite its line endings — a Windows clone would otherwise fail the drift test.
/openapi.json text eol=lf

# The built web UI is embedded byte for byte and checked against a fresh build in CI, so a checkout must
# never rewrite it either.
/ui/dist/** -text

# The committed thresholds are compared byte for byte with what calibration writes (ticket 69), so a
# checkout must never rewrite their line endings — a Windows clone would otherwise fail that test.
/crates/keepster-testkit/bench/thresholds.toml text eol=lf

# The install scripts run under `sh` and bash, which read a carriage return as part of each line, so a
# Windows checkout must never give them CRLF.
/scripts/install.sh text eol=lf
/scripts/test-install.sh text eol=lf
